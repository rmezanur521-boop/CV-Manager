<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cv_position_tree" model="ir.ui.view">
        <field name="name">cv.position.tree</field>
        <field name="model">cv.position</field>
        <field name="arch" type="xml">
            <tree string="Positions" create="false" edit="false">
                <field name="external_id" />
                <field name="title" />
                <field name="company" />
                <field name="level" />
                <field name="published_cv_count" />
                <field name="last_synced_at" />
            </tree>
        </field>
    </record>

    <record id="view_cv_position_form" model="ir.ui.view">
        <field name="name">cv.position.form</field>
        <field name="model">cv.position</field>
        <field name="arch" type="xml">
            <form string="Position" create="false" edit="false">
                <header>
                    <button name="action_sync" string="Sync / Re-import" type="object" class="oe_highlight" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="title" readonly="1" />
                        </h1>
                        <h3>
                            <field name="company" readonly="1" class="oe_inline" />
                            <span invisible="not company or not level"> - </span>
                            <field name="level" readonly="1" class="oe_inline" />
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="external_id" readonly="1" />
                            <field name="published_cv_count" readonly="1" />
                        </group>
                        <group>
                            <field name="last_synced_at" readonly="1" />
                            <field name="api_base_url" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Attributes &amp; Aggregates">
                            <field name="attribute_ids" readonly="1">
                                <tree string="Attributes">
                                    <field name="attribute_id" />
                                    <field name="name" />
                                    <field name="attribute_type" />
                                    <field name="is_required" />
                                    <field name="response_count" />
                                    <field name="summary" />
                                </tree>
                                <form string="Attribute Details">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name" readonly="1" />
                                                <field name="attribute_type" readonly="1" />
                                                <field name="is_required" readonly="1" />
                                                <field name="response_count" readonly="1" />
                                            </group>
                                            <group>
                                                <field name="summary" readonly="1" />
                                            </group>
                                        </group>
                                        <group string="Numeric Statistics" invisible="attribute_type != 'Numeric'">
                                            <field name="numeric_min" readonly="1" />
                                            <field name="numeric_max" readonly="1" />
                                            <field name="numeric_average" readonly="1" />
                                        </group>
                                        <group string="Date Statistics" invisible="attribute_type != 'Date'">
                                            <field name="date_min" readonly="1" />
                                            <field name="date_max" readonly="1" />
                                        </group>
                                        <group string="Date Range Statistics" invisible="attribute_type != 'DateRange'">
                                            <field name="date_range_earliest_start" readonly="1" />
                                            <field name="date_range_latest_end" readonly="1" />
                                        </group>
                                        <group string="Boolean Counts" invisible="attribute_type != 'Boolean'">
                                            <field name="boolean_true_count" readonly="1" />
                                            <field name="boolean_false_count" readonly="1" />
                                        </group>
                                        <group string="Markdown Statistics" invisible="attribute_type != 'MarkdownText'">
                                            <field name="markdown_avg_length" readonly="1" />
                                        </group>
                                        <group string="Value Breakdown" invisible="attribute_type not in ['Dropdown', 'SingleLineText']">
                                            <field name="value_breakdown_ids" readonly="1">
                                                <tree string="Values">
                                                    <field name="value" />
                                                    <field name="count" />
                                                </tree>
                                            </field>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="short_description" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cv_position_search" model="ir.ui.view">
        <field name="name">cv.position.search</field>
        <field name="model">cv.position</field>
        <field name="arch" type="xml">
            <search string="Search Positions">
                <field name="title" />
                <field name="company" />
                <field name="level" />
                <field name="external_id" />
                <group expand="0" string="Group By">
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company'}" />
                    <filter name="group_by_level" string="Level" context="{'group_by': 'level'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_cv_position" model="ir.actions.act_window">
        <field name="name">Positions</field>
        <field name="res_model">cv.position</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cv_position_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No positions imported yet!
            </p>
            <p>
                Use the "Import Position" action to synchronize position aggregates from CVPlatform using an API token.
            </p>
        </field>
    </record>
</odoo>
