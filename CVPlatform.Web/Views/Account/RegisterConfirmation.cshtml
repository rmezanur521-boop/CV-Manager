@{
    ViewData["Title"] = "Registration Successful";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card-icon info">
            <i class="bi bi-envelope-check"></i>
        </div>
        <h2 class="auth-title">Registration Successful</h2>
        <p class="auth-status-text">Please check the application log (development mode) for your confirmation link, or check your email.</p>
        <a asp-action="Login" asp-controller="Account" class="btn auth-btn-primary">Go to Login</a>
    </div>
</div>