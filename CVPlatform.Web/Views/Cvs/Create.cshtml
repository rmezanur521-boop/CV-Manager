@model IReadOnlyList<CVPlatform.Application.Cvs.AvailablePositionDto>

@{
    ViewData["Title"] = "New CV";
}

<div class="page-header">
    <h1>@Html.T("Cvs.ChoosePosition")</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">@Html.T("Cvs.BackToList")</a>
</div>

<div class="surface-card" style="max-width:520px;">
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-briefcase" style="font-size:1.6rem;"></i>
            <p class="mb-0 mt-2">@Html.T("Cvs.NoPositionsAvailable")</p>
        </div>
    }
    else
    {
        <form asp-action="Create" method="post">
            <div class="field mb-3">
                <label>@Html.T("Cvs.SelectPositionPrompt")</label>
                <select name="positionId" class="form-select">
                    @foreach (var position in Model)
                    {
                        <option value="@position.PositionId">@position.Title</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">@Html.T("Cvs.Create")</button>
        </form>
    }
</div>