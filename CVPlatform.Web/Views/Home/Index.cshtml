@model CVPlatform.Application.PublicSite.PublicLandingDto
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = Html.T("Public.MetaTitle");
    ViewData["MetaDescription"] = Html.T("Public.MetaDescription");
}

<section class="hero-section">
    <div class="hero-badge">
        <i class="bi bi-stars"></i>
        <span>@Html.T("Public.HeroBadge")</span>
    </div>
    <h1 class="hero-title">
        @Html.T("Public.HeroTitlePrefix")
        <span class="hero-highlight">@Html.T("Public.HeroTitleHighlight")</span>
        @Html.T("Public.HeroTitleSuffix")
    </h1>
    <p class="hero-subtitle">
        @Html.T("Public.HeroSubtitle")
    </p>
    <div class="hero-ctas">
        <a class="btn btn-primary px-4 py-2" asp-controller="Account" asp-action="Register">
            <i class="bi bi-rocket-takeoff me-2"></i>@Html.T("Public.GetStarted")
        </a>
        <a class="btn btn-outline-primary px-4 py-2" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-2"></i>@Html.T("Nav.Login")
        </a>
    </div>
</section>

<section class="public-stats-strip">
    <div class="public-stats-inner">
        <div class="public-stat-item">
            <div class="stat-number">@Model.Stats.OpenPositionsCount</div>
            <div class="stat-desc">@Html.T("Public.StatsOpenPositions")</div>
        </div>
        <div class="public-stat-item">
            <div class="stat-number">@Model.Stats.CandidatesCount</div>
            <div class="stat-desc">@Html.T("Public.StatsCandidates")</div>
        </div>
        <div class="public-stat-item">
            <div class="stat-number">@Model.Stats.PublishedCvsCount</div>
            <div class="stat-desc">@Html.T("Public.StatsPublishedCvs")</div>
        </div>
    </div>
</section>

<section class="public-section" id="how-it-works">
    <div class="public-section-head">
        <h2 class="public-section-title">@Html.T("Public.HowItWorksTitle")</h2>
        <p class="public-section-desc">@Html.T("Public.HowItWorksSubtitle")</p>
    </div>
    <div class="steps-grid">
        <div class="step-card">
            <div class="step-number">1</div>
            <h3 class="step-title">@Html.T("Public.Step1Title")</h3>
            <p class="step-desc">@Html.T("Public.Step1Desc")</p>
        </div>
        <div class="step-card">
            <div class="step-number">2</div>
            <h3 class="step-title">@Html.T("Public.Step2Title")</h3>
            <p class="step-desc">@Html.T("Public.Step2Desc")</p>
        </div>
        <div class="step-card">
            <div class="step-number">3</div>
            <h3 class="step-title">@Html.T("Public.Step3Title")</h3>
            <p class="step-desc">@Html.T("Public.Step3Desc")</p>
        </div>
    </div>
</section>

<section class="public-section pt-0">
    <div class="audience-grid">
        <div class="audience-card" id="for-candidates">
            <div class="audience-header">
                <div class="audience-icon candidate-icon">
                    <i class="bi bi-person-workspace"></i>
                </div>
                <h3 class="audience-title">@Html.T("Public.ForCandidatesTitle")</h3>
            </div>
            <ul class="feature-list">
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.CandFeat1")</span>
                </li>
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.CandFeat2")</span>
                </li>
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.CandFeat3")</span>
                </li>
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.CandFeat4")</span>
                </li>
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.CandFeat5")</span>
                </li>
            </ul>
            <div class="mt-4">
                <a class="btn btn-primary w-100" asp-controller="Account" asp-action="Register">
                    @Html.T("Public.JoinAsCandidate")
                </a>
            </div>
        </div>

        <div class="audience-card" id="for-recruiters">
            <div class="audience-header">
                <div class="audience-icon recruiter-icon">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <h3 class="audience-title">@Html.T("Public.ForRecruitersTitle")</h3>
            </div>
            <ul class="feature-list">
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.RecFeat1")</span>
                </li>
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.RecFeat2")</span>
                </li>
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.RecFeat3")</span>
                </li>
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.RecFeat4")</span>
                </li>
                <li class="feature-list-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@Html.T("Public.RecFeat5")</span>
                </li>
            </ul>
            <div class="mt-4">
                <a class="btn btn-outline-primary w-100" asp-controller="Account" asp-action="Login">
                    @Html.T("Public.LoginAsRecruiter")
                </a>
            </div>
        </div>
    </div>
</section>

@if (Model.OpenPositions.Any())
{
    <section class="public-section pt-0" id="open-positions">
        <div class="public-section-head">
            <h2 class="public-section-title">@Html.T("Public.OpenPositionsTitle")</h2>
            <p class="public-section-desc">@Html.T("Public.OpenPositionsSubtitle")</p>
        </div>
        <div class="positions-teaser-grid">
            @foreach (var pos in Model.OpenPositions)
            {
                <div class="teaser-card">
                    <div class="teaser-card-top">
                        <h4 class="teaser-title">@pos.Title</h4>
                        <div class="teaser-meta">
                            @if (!string.IsNullOrWhiteSpace(pos.Company))
                            {
                                <span><i class="bi bi-building me-1"></i>@pos.Company</span>
                            }
                            @if (pos.Level.HasValue)
                            {
                                <span class="badge-soft-success">@pos.Level.Value</span>
                            }
                        </div>
                        <p class="teaser-desc">
                            @(pos.ShortDescription.Length > 110 ? pos.ShortDescription.Substring(0, 110) + "..." : pos.ShortDescription)
                        </p>
                    </div>
                    <div>
                        <a class="btn btn-outline-primary btn-sm w-100" asp-controller="Account" asp-action="Register">
                            @Html.T("Public.RegisterToApply")
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>
}

<section class="final-cta-section">
    <div class="final-cta-card">
        <h2 class="final-cta-title">@Html.T("Public.FinalCtaTitle")</h2>
        <p class="final-cta-subtitle">@Html.T("Public.FinalCtaSubtitle")</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a class="btn btn-primary px-4 py-2" asp-controller="Account" asp-action="Register">
                <i class="bi bi-person-plus-fill me-2"></i>@Html.T("Nav.Register")
            </a>
            <a class="btn btn-outline-primary px-4 py-2" asp-controller="Account" asp-action="Login">
                <i class="bi bi-box-arrow-in-right me-2"></i>@Html.T("Nav.Login")
            </a>
        </div>
    </div>
</section>