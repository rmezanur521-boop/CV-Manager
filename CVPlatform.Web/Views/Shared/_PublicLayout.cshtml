@{
    var currentTheme = Context.Request.Cookies["cvplatform-theme"] ?? "light";
    var nextTheme = currentTheme == "dark" ? "light" : "dark";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var otherCulture = currentCulture.StartsWith("bn") ? "en" : "bn";
}
<!DOCTYPE html>
<html lang="en" data-theme="@currentTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CV Manager</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "CV Manager - The modern platform connecting talented candidates with recruiters through structured profiles and tailored CVs.")" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/sidebar-layout.css" />
    <link rel="stylesheet" href="~/css/public.css" />
    <script>
        (function () {
            var match = document.cookie.match(/cvplatform-theme=(dark|light)/);
            var theme = match ? match[1] : "@currentTheme";
            document.documentElement.setAttribute("data-theme", theme);
        })();
    </script>
</head>
<body>

    <header class="public-header">
        <div class="public-header-inner">
            <a class="public-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon-box">
                    <i class="bi bi-file-earmark-person-fill"></i>
                </span>
                <span>CV Manager</span>
            </a>

            <nav class="public-nav">
                <a class="public-nav-link" href="@Url.Action("Index", "Home")#how-it-works">@Html.T("Public.NavHowItWorks")</a>
                <a class="public-nav-link" href="@Url.Action("Index", "Home")#for-candidates">@Html.T("Public.NavForCandidates")</a>
                <a class="public-nav-link" href="@Url.Action("Index", "Home")#for-recruiters">@Html.T("Public.NavForRecruiters")</a>
                <a class="public-nav-link" href="@Url.Action("Index", "Home")#open-positions">@Html.T("Public.NavOpenPositions")</a>
            </nav>

            <div class="public-actions">
                <button type="button" class="nav-icon-btn" id="headerThemeBtn" title="@Html.T("Common.DarkMode")" aria-label="Toggle theme">
                    <i id="headerThemeIcon" class="bi @(currentTheme == "dark" ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
                </button>
                <a class="nav-icon-btn" title="@Html.T("Common.Language")" asp-controller="Settings" asp-action="SetLanguage" asp-route-culture="@otherCulture" asp-route-returnUrl="@Context.Request.Path" aria-label="Change language">
                    <i class="bi bi-translate"></i>
                </a>
                <a class="btn-nav-login" asp-controller="Account" asp-action="Login">@Html.T("Nav.Login")</a>
                <a class="btn-nav-register" asp-controller="Account" asp-action="Register">@Html.T("Nav.Register")</a>

                <button type="button" class="public-mobile-toggle" id="publicMobileToggle" aria-label="Toggle mobile navigation" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div class="public-mobile-menu" id="publicMobileMenu">
            <a class="public-mobile-nav-link" href="@Url.Action("Index", "Home")#how-it-works">@Html.T("Public.NavHowItWorks")</a>
            <a class="public-mobile-nav-link" href="@Url.Action("Index", "Home")#for-candidates">@Html.T("Public.NavForCandidates")</a>
            <a class="public-mobile-nav-link" href="@Url.Action("Index", "Home")#for-recruiters">@Html.T("Public.NavForRecruiters")</a>
            <a class="public-mobile-nav-link" href="@Url.Action("Index", "Home")#open-positions">@Html.T("Public.NavOpenPositions")</a>
            <div class="public-mobile-actions">
                <a class="btn-nav-register text-center" asp-controller="Account" asp-action="Register">@Html.T("Nav.Register")</a>
                <a class="btn-nav-login text-center" asp-controller="Account" asp-action="Login">@Html.T("Nav.Login")</a>
            </div>
        </div>
    </header>

    <main class="public-main">
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="public-footer-inner">
            <div class="footer-col-brand">
                <a class="footer-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-box">
                        <i class="bi bi-file-earmark-person-fill"></i>
                    </span>
                    <span>CV Manager</span>
                </a>
                <p class="footer-desc">@Html.T("Public.FooterDesc")</p>
                <div class="footer-social-links">
                    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Twitter"><i class="bi bi-twitter-x"></i></a>
                    <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub"><i class="bi bi-github"></i></a>
                </div>
            </div>
            <div>
                <div class="footer-col-title">@Html.T("Public.FooterNavigation")</div>
                <ul class="footer-links">
                    <li><a class="footer-link" asp-controller="Home" asp-action="Index">@Html.T("Public.NavHome")</a></li>
                    <li><a class="footer-link" href="@Url.Action("Index", "Home")#how-it-works">@Html.T("Public.NavHowItWorks")</a></li>
                    <li><a class="footer-link" href="@Url.Action("Index", "Home")#for-candidates">@Html.T("Public.NavForCandidates")</a></li>
                    <li><a class="footer-link" href="@Url.Action("Index", "Home")#for-recruiters">@Html.T("Public.NavForRecruiters")</a></li>
                    <li><a class="footer-link" href="@Url.Action("Index", "Home")#open-positions">@Html.T("Public.NavOpenPositions")</a></li>
                    <li><a class="footer-link" asp-controller="Home" asp-action="Privacy">@Html.T("Public.NavPrivacy")</a></li>
                </ul>
            </div>
            <div>
                <div class="footer-col-title">@Html.T("Public.FooterAccount")</div>
                <ul class="footer-links">
                    <li><a class="footer-link" asp-controller="Account" asp-action="Login">@Html.T("Nav.Login")</a></li>
                    <li><a class="footer-link" asp-controller="Account" asp-action="Register">@Html.T("Nav.Register")</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="footer-copy">&copy; @DateTime.UtcNow.Year CV Manager. @Html.T("Public.AllRightsReserved")</div>
            <div class="footer-controls">
                <div class="footer-theme-toggle">
                    <span class="theme-toggle-label">Dark Mode</span>
                    <label class="switch-toggle" for="footerThemeSwitch">
                        <input type="checkbox" id="footerThemeSwitch" @(currentTheme == "dark" ? "checked" : "") aria-label="Toggle Dark Mode" />
                        <span class="switch-slider"></span>
                    </label>
                </div>
                <span class="footer-divider">&bull;</span>
                <a class="footer-link" asp-controller="Settings" asp-action="SetLanguage" asp-route-culture="@otherCulture" asp-route-returnUrl="@Context.Request.Path">
                    <i class="bi bi-translate me-1"></i>@(otherCulture.StartsWith("bn") ? "বাংলা" : "English")
                </a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/public-landing.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
