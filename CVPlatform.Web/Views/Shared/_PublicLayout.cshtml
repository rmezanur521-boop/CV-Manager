<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CV Manager</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "CV Manager - The modern platform connecting talented candidates with recruiters through structured profiles and tailored CVs.")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/sidebar-layout.css" />
    <link rel="stylesheet" href="~/css/public.css" />
    <script>
        (function () {
            var match = document.cookie.match(/cvplatform-theme=(dark|light)/);
            var theme = match ? match[1] : "light";
            document.documentElement.setAttribute("data-theme", theme);
        })();
    </script>
</head>
<body>
    @{
        var currentTheme = Context.Request.Cookies["cvplatform-theme"] ?? "light";
        var nextTheme = currentTheme == "dark" ? "light" : "dark";
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        var otherCulture = currentCulture.StartsWith("bn") ? "en" : "bn";
    }

    <header class="public-header">
        <div class="public-header-inner">
            <a class="public-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-file-earmark-person-fill"></i>
                <span>CV Manager</span>
            </a>

            <nav class="public-nav">
                <a class="public-nav-link" href="@Url.Action("Index", "Home")#how-it-works">@Html.T("Public.NavHowItWorks")</a>
                <a class="public-nav-link" href="@Url.Action("Index", "Home")#for-candidates">@Html.T("Public.NavForCandidates")</a>
                <a class="public-nav-link" href="@Url.Action("Index", "Home")#for-recruiters">@Html.T("Public.NavForRecruiters")</a>
                <a class="public-nav-link" href="@Url.Action("Index", "Home")#open-positions">@Html.T("Public.NavOpenPositions")</a>
            </nav>

            <div class="public-actions">
                <a class="icon-btn" title="@Html.T("Common.DarkMode")" asp-controller="Settings" asp-action="SetTheme" asp-route-theme="@nextTheme" asp-route-returnUrl="@Context.Request.Path">
                    <i class="bi @(currentTheme == "dark" ? "bi-sun" : "bi-moon-stars")"></i>
                </a>
                <a class="icon-btn" title="@Html.T("Common.Language")" asp-controller="Settings" asp-action="SetLanguage" asp-route-culture="@otherCulture" asp-route-returnUrl="@Context.Request.Path">
                    <i class="bi bi-translate"></i>
                </a>
                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">@Html.T("Nav.Login")</a>
                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">@Html.T("Nav.Register")</a>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="public-footer-inner">
            <div>
                <a class="footer-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-file-earmark-person-fill"></i>
                    <span>CV Manager</span>
                </a>
                <p class="footer-desc">@Html.T("Public.FooterDesc")</p>
            </div>
            <div>
                <div class="footer-col-title">@Html.T("Public.FooterNavigation")</div>
                <ul class="footer-links">
                    <li><a class="footer-link" asp-controller="Home" asp-action="Index">@Html.T("Public.NavHome")</a></li>
                    <li><a class="footer-link" href="@Url.Action("Index", "Home")#how-it-works">@Html.T("Public.NavHowItWorks")</a></li>
                    <li><a class="footer-link" asp-controller="Home" asp-action="Privacy">@Html.T("Public.NavPrivacy")</a></li>
                </ul>
            </div>
            <div>
                <div class="footer-col-title">@Html.T("Public.FooterAccount")</div>
                <ul class="footer-links">
                    <li><a class="footer-link" asp-controller="Account" asp-action="Login">@Html.T("Nav.Login")</a></li>
                    <li><a class="footer-link" asp-controller="Account" asp-action="Register">@Html.T("Nav.Register")</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <div>&copy; @DateTime.UtcNow.Year CV Manager. @Html.T("Public.AllRightsReserved")</div>
            <div class="footer-controls">
                <a class="footer-link" asp-controller="Settings" asp-action="SetTheme" asp-route-theme="@nextTheme" asp-route-returnUrl="@Context.Request.Path">
                    @(currentTheme == "dark" ? Html.T("Common.LightMode") : Html.T("Common.DarkMode"))
                </a>
                <span>&bull;</span>
                <a class="footer-link" asp-controller="Settings" asp-action="SetLanguage" asp-route-culture="@otherCulture" asp-route-returnUrl="@Context.Request.Path">
                    @(otherCulture.StartsWith("bn") ? "বাংলা" : "English")
                </a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
