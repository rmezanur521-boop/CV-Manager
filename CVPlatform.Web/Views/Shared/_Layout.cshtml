
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CV Manager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/sidebar-layout.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <script>
        (function () {
            var match = document.cookie.match(/cvplatform-theme=(dark|light)/);
            var theme = match ? match[1] : "light";
            document.documentElement.setAttribute("data-theme", theme);

            if (window.localStorage && localStorage.getItem("cvplatform-sidebar-open") === "false") {
                document.documentElement.classList.add("sidebar-collapsed");
            }
        })();
    </script>
</head>
<body>
    @{
        var isAuthed = User.Identity!.IsAuthenticated;
        var isRecruiterOrAdmin = User.IsInRole("Recruiter") || User.IsInRole("Administrator");
        var isAdmin = User.IsInRole("Administrator");
        var isCandidate = User.IsInRole("Candidate");
        var currentTheme = Context.Request.Cookies["cvplatform-theme"] ?? "light";
        var nextTheme = currentTheme == "dark" ? "light" : "dark";
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        var otherCulture = currentCulture.StartsWith("bn") ? "en" : "bn";
        var activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var roleLabel = isAdmin ? "Administrator" : (User.IsInRole("Recruiter") ? "Recruiter" : "Candidate");
    }

    @if (!isAuthed)
    {
        <header class="guest-header">
            <div class="guest-header-inner">
                <a class="guest-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-file-earmark-person-fill"></i>
                    <span>CV Manager</span>
                </a>
                <nav class="guest-nav">
                </nav>
                <div class="guest-actions">
                    <a class="icon-btn" title="@Html.T("Common.DarkMode")" asp-controller="Settings" asp-action="SetTheme" asp-route-theme="@nextTheme" asp-route-returnUrl="@Context.Request.Path">
                        <i class="bi @(currentTheme == "dark" ? "bi-sun" : "bi-moon-stars")"></i>
                    </a>
                    <a class="icon-btn" title="@Html.T("Common.Language")" asp-controller="Settings" asp-action="SetLanguage" asp-route-culture="@otherCulture" asp-route-returnUrl="@Context.Request.Path">
                        <i class="bi bi-translate"></i>
                    </a>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                </div>
            </div>
        </header>
        <main class="guest-main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="app-shell">
            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
            <div class="sidebar" id="appSidebar">
                <div class="sidebar-header">
                    <div class="sidebar-brand">
                        <i class="bi bi-file-earmark-person-fill"></i>
                        <span>CV Manager</span>
                    </div>
                    <button type="button" class="sidebar-close" data-sidebar-toggle aria-label="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="sidebar-body">
                    <div>
                        <nav class="sidebar-nav">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link @(activeController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i><span>@Html.T("Nav.Dashboard")</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeController == "Positions" ? "active" : "")" asp-controller="Positions" asp-action="Index">
                                        <i class="bi bi-briefcase"></i><span>@Html.T("Nav.Positions")</span>
                                    </a>
                                </li>
                                @if (isRecruiterOrAdmin)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link @(activeController == "Attributes" ? "active" : "")" asp-controller="Attributes" asp-action="Index">
                                            <i class="bi bi-diagram-3"></i><span>@Html.T("Nav.Attributes")</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(activeController == "RecruiterCvs" ? "active" : "")" asp-controller="RecruiterCvs" asp-action="Index">
                                            <i class="bi bi-file-earmark-text"></i><span>@Html.T("Nav.BrowseCvs")</span>
                                        </a>
                                    </li>
                                }
                                @if (isCandidate)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link @(activeController == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index">
                                            <i class="bi bi-person-badge"></i><span>@Html.T("Nav.Profile")</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(activeController == "Cvs" ? "active" : "")" asp-controller="Cvs" asp-action="Index">
                                            <i class="bi bi-file-earmark-person"></i><span>@Html.T("Nav.MyCvs")</span>
                                        </a>
                                    </li>
                                }
                                @if (isAdmin)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link @(activeController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                                            <i class="bi bi-people"></i><span>@Html.T("Nav.Users")</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                    <div class="sidebar-footer">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Settings" asp-action="SetTheme" asp-route-theme="@nextTheme" asp-route-returnUrl="@Context.Request.Path">
                                    <i class="bi @(currentTheme == "dark" ? "bi-sun" : "bi-moon-stars")"></i><span>@(currentTheme == "dark" ? Html.T("Common.LightMode") : Html.T("Common.DarkMode"))</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn-logout">
                                        <i class="bi bi-box-arrow-right"></i><span>@Html.T("Nav.Logout")</span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="app-main">
                <header class="app-header">
                    <button type="button" class="icon-btn" data-sidebar-toggle aria-controls="appSidebar">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="app-search">
                        <i class="bi bi-search"></i>
                        <input type="text" id="global-search" autocomplete="off" placeholder="@Html.T("Common.SearchPlaceholder")" />
                        <div id="search-results" class="app-search-results"></div>
                    </div>

                    <div class="app-header-actions">
                        <button type="button" class="icon-btn" data-bs-toggle="modal" data-bs-target="#supportTicketModal" title="@Html.T("Support.HelpTooltip")">
                            <i class="bi bi-question-circle"></i>
                        </button>
                        <a class="icon-btn" title="@Html.T("Common.Language")" asp-controller="Settings" asp-action="SetLanguage" asp-route-culture="@otherCulture" asp-route-returnUrl="@Context.Request.Path">
                            <i class="bi bi-translate"></i>
                        </a>
                        <span class="icon-btn" title="@Html.T("Common.Notifications")">
                            <i class="bi bi-bell"></i>
                        </span>
                        <div class="app-user">
                            <div class="app-user-avatar"><i class="bi bi-person-fill"></i></div>
                            <div class="app-user-info">
                                <span class="app-user-name">@User.Identity!.Name</span>
                                <span class="app-user-role">@roleLabel</span>
                            </div>
                        </div>
                    </div>
                </header>

                <main class="app-content">
                    @RenderBody()
                </main>

                <footer class="app-footer">
                    <div class="app-footer-inner">
                        <button type="button" class="btn-support-link" data-bs-toggle="modal" data-bs-target="#supportTicketModal">
                            <i class="bi bi-life-preserver me-1"></i>@Html.T("Support.CreateTicket")
                        </button>
                        <span class="text-muted small">&copy; @DateTime.UtcNow.Year CV Manager. @Html.T("Support.AllRightsReserved")</span>
                    </div>
                </footer>
            </div>
            <partial name="_SupportTicketModal" />
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sidebar-toggle.js"></script>
    <script src="~/js/global-search.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/support-ticket.js"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>