@using CVPlatform.Application.Positions
@using CVPlatform.Web.Models.Positions
@model PositionFormViewModel

@{
    ViewData["Title"] = "Edit Position";
    var tokenStatus = ViewBag.ApiTokenStatus as PositionApiTokenStatusDto;
    var generatedToken = TempData["GeneratedToken"] as string;
}

<div class="page-header">
    <h1>@Html.T("Positions.EditTitle")</h1>
    <div class="header-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">@Html.T("Common.Cancel")</a>
        <button type="submit" form="position-form" class="btn btn-primary">@Html.T("Common.Save")</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(generatedToken))
{
    <div class="alert alert-success d-flex flex-column gap-2 mb-4">
        <div class="fw-semibold">
            <i class="bi bi-check-circle me-1"></i> @Html.T("Positions.TokenCreatedSuccess")
        </div>
        <div class="input-group" style="max-width: 650px;">
            <input type="text" id="new-api-token" class="form-control font-monospace" value="@generatedToken" readonly />
            <button class="btn btn-outline-success" type="button" id="copy-token-btn" onclick="navigator.clipboard.writeText(document.getElementById('new-api-token').value).then(() => { this.innerText = '@Html.T("Positions.TokenCopied")'; setTimeout(() => this.innerText = '@Html.T("Positions.TokenCopy")', 2500); });">
                <i class="bi bi-clipboard"></i> @Html.T("Positions.TokenCopy")
            </button>
        </div>
    </div>
}

<form asp-action="Edit" method="post" id="position-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Version" />
    <partial name="_PositionForm" model="Model" />
</form>

<div class="surface-card mb-4">
    <div class="section-title">@Html.T("Positions.IntegrationTitle")</div>
    <p class="text-muted small">@Html.T("Positions.IntegrationDesc")</p>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 rounded" style="background: var(--surface-bg-subtle, rgba(0,0,0,0.02)); border: 1px solid var(--border-color, #dee2e6);">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="fw-semibold">@Html.T("Positions.TokenStatus"):</span>
                @if (tokenStatus != null && tokenStatus.HasToken && !tokenStatus.IsRevoked)
                {
                    <span class="badge bg-success">@Html.T("Positions.TokenActive")</span>
                }
                else if (tokenStatus != null && tokenStatus.HasToken && tokenStatus.IsRevoked)
                {
                    <span class="badge bg-danger">@Html.T("Positions.TokenRevoked")</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Html.T("Positions.TokenNone")</span>
                }
            </div>

            @if (tokenStatus != null && tokenStatus.HasToken)
            {
                <div class="small text-muted mb-1">
                    <span class="fw-semibold">@Html.T("Positions.TokenPrefixLabel"):</span>
                    <code class="font-monospace ms-1">@tokenStatus.TokenPrefix...</code>
                </div>
                <div class="small text-muted mb-1">
                    <span class="fw-semibold">@Html.T("Positions.TokenCreatedAt"):</span>
                    <span class="ms-1">@(tokenStatus.CreatedAt?.ToLocalTime().ToString("g") ?? "—")</span>
                </div>
                <div class="small text-muted">
                    <span class="fw-semibold">@Html.T("Positions.TokenLastUsedAt"):</span>
                    <span class="ms-1">@(tokenStatus.LastUsedAt.HasValue ? tokenStatus.LastUsedAt.Value.ToLocalTime().ToString("g") : Html.T("Positions.TokenNeverUsed"))</span>
                </div>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (tokenStatus != null && tokenStatus.HasToken && !tokenStatus.IsRevoked)
            {
                <form asp-action="GenerateToken" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('@Html.T("Positions.ConfirmRegenerateToken")');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-arrow-repeat me-1"></i> @Html.T("Positions.RegenerateToken")
                    </button>
                </form>
                <form asp-action="RevokeToken" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('@Html.T("Positions.ConfirmRevokeToken")');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-x-circle me-1"></i> @Html.T("Positions.RevokeToken")
                    </button>
                </form>
            }
            else
            {
                <form asp-action="GenerateToken" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-key me-1"></i> @Html.T("Positions.GenerateToken")
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/positions-form.js"></script>
}