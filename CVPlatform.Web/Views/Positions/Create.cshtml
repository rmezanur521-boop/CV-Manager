@using CVPlatform.Web.Models.Positions
@model PositionFormViewModel

@{
    ViewData["Title"] = "New Position";
}

<div class="page-header">
    <h1>@Html.T("Positions.New")</h1>
    <div class="header-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">@Html.T("Common.Cancel")</a>
        <button type="submit" form="position-form" class="btn btn-primary">@Html.T("Common.Save")</button>
    </div>
</div>

<form asp-action="Create" method="post" id="position-form">
    <partial name="_PositionForm" model="Model" />
</form>

<div class="surface-card mb-4">
    <div class="section-title">@Html.T("Positions.IntegrationTitle")</div>
    <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i>@Html.T("Positions.CreateSaveFirstNotice")</p>
</div>

@section Scripts {
    <script src="~/js/positions-form.js"></script>
}