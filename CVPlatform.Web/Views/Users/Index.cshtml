@model IReadOnlyList<CVPlatform.Application.Users.UserSummaryDto>

@{
    ViewData["Title"] = Html.T("Users.Title");
    var roles = ViewBag.AvailableRoles as string[] ?? Array.Empty<string>();
    var currentUserId = ViewBag.CurrentUserId as string;
    var selectedRole = ViewBag.Role as string;
}

<div class="page-header">
    <h1>@Html.T("Users.Title")</h1>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="surface-card">
    <form method="get" class="page-toolbar">
        <div class="page-search">
            <i class="bi bi-search"></i>
            <input type="text" name="q" value="@ViewBag.Query" placeholder="@Html.T("Users.SearchPlaceholder")" />
        </div>
        <select name="role" class="form-select" style="width:auto">
            <option value="">@Html.T("Users.AllRoles")</option>
            @foreach (var role in roles)
            {
                <option value="@role" selected="@(role == selectedRole)">@Html.T($"Role.{role}")</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary btn-sm">@Html.T("Common.Search")</button>
        <div class="page-toolbar-actions">
            <a class="icon-btn" href="@Url.Action("Index")" title="@Html.T("Common.Refresh")">
                <i class="bi bi-arrow-clockwise"></i>
            </a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-people" style="font-size:1.6rem;"></i>
            <p class="mb-0 mt-2">@Html.T("Users.NoResults")</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table" id="users-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>@Html.T("Users.Name")</th>
                        <th>@Html.T("Users.Email")</th>
                        <th>@Html.T("Users.Role")</th>
                        <th>@Html.T("Users.Confirmed")</th>
                        <th>@Html.T("Users.Status")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="user-row selectable-row"
                            data-id="@user.Id"
                            data-role="@user.CurrentRole"
                            data-blocked="@user.IsBlocked.ToString().ToLower()"
                            data-self="@((user.Id == currentUserId).ToString().ToLower())"
                            data-profile-url="@Url.Action("Index", "Profile", new { id = user.Id })"
                            data-cvs-url="@Url.Action("Index", "Cvs", new { candidateId = user.Id })">
                            <td>
                                <input type="radio" name="selectedUser" value="@user.Id" class="form-check-input" />
                            </td>
                            <td class="fw-semibold">@(string.IsNullOrWhiteSpace(user.FullName) ? "—" : user.FullName)</td>
                            <td>@user.Email</td>
                            <td>
                                @if (string.IsNullOrEmpty(user.CurrentRole))
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <span class="badge-soft-info">@Html.T($"Role.{user.CurrentRole}")</span>
                                }
                            </td>
                            <td>
                                <span class="badge-soft-@(user.EmailConfirmed ? "success" : "warning")">
                                    @Html.T(user.EmailConfirmed ? "Common.Yes" : "Common.No")
                                </span>
                            </td>
                            <td>
                                <span class="badge-soft-@(user.IsBlocked ? "danger" : "success")">
                                    @Html.T(user.IsBlocked ? "Users.Blocked" : "Users.Active")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="selection-bar">
            <span class="hint" id="selection-hint"
                  data-default-hint="@Html.T("Users.SelectRowHint")"
                  data-self-hint="@Html.T("Users.SelfHint")">@Html.T("Users.SelectRowHint")</span>

            <a class="btn btn-outline-secondary btn-sm disabled" id="view-profile-btn" href="#">
                <i class="bi bi-person"></i> @Html.T("Users.ViewProfile")
            </a>
            <a class="btn btn-outline-secondary btn-sm disabled" id="view-cvs-btn" href="#">
                <i class="bi bi-file-earmark-person"></i> @Html.T("Users.ViewCvs")
            </a>

            <form method="post" asp-action="AssignRole" id="user-actions-form" class="d-flex flex-wrap align-items-center gap-2">
                <input type="hidden" name="userId" id="selected-user-id" />
                <select name="newRole" id="role-select" class="form-select form-select-sm" style="width:auto" disabled>
                    @foreach (var role in roles)
                    {
                        <option value="@role">@Html.T($"Role.{role}")</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-secondary btn-sm" id="assign-btn" formaction="@Url.Action("AssignRole")" disabled>
                    <i class="bi bi-shield-check"></i> @Html.T("Users.AssignRole")
                </button>
                <button type="submit" class="btn btn-outline-warning btn-sm" id="block-btn" formaction="@Url.Action("Block")" disabled>
                    <i class="bi bi-slash-circle"></i> @Html.T("Users.Block")
                </button>
                <button type="submit" class="btn btn-outline-success btn-sm" id="unblock-btn" formaction="@Url.Action("Unblock")" disabled>
                    <i class="bi bi-check-circle"></i> @Html.T("Users.Unblock")
                </button>
                <button type="submit" class="btn btn-outline-danger btn-sm" id="delete-btn" formaction="@Url.Action("Delete")"
                        data-confirm="@Html.T("Users.ConfirmDelete")" disabled>
                    <i class="bi bi-trash"></i> @Html.T("Common.Delete")
                </button>
            </form>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/users-toolbar.js" asp-append-version="true"></script>
}