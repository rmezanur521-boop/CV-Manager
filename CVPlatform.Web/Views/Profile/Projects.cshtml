@model IReadOnlyList<CVPlatform.Application.Projects.ProjectDto>
@{
    ViewData["Title"] = "My Projects";
    var summary = (CVPlatform.Web.Models.Profile.ProfileSummaryViewModel)ViewBag.Summary;
    var routeId = summary.IsAdminViewingOther ? summary.TargetId : null;
}

<div class="page-header">
    <h1>@Html.T("Profile.Projects")</h1>
    <a class="btn btn-primary" asp-action="CreateProject" asp-route-id="@routeId">
        <i class="bi bi-plus-lg"></i> @Html.T("Profile.NewProject")
    </a>
</div>

<div class="profile-grid">
    @await Html.PartialAsync("_ProfileSummaryCard", summary)

    <div class="profile-content-card">
        @await Html.PartialAsync("_ProfileTabs", "Projects")

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-kanban" style="font-size:1.6rem;"></i>
                <p class="mb-0 mt-2">@Html.T("Profile.NoProjectsYet")</p>
            </div>
        }
        else
        {
            @foreach (var project in Model)
            {
                <div class="project-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <h3>@project.Name</h3>
                        <div class="d-flex gap-2">
                            <a class="icon-btn icon-btn-sm" asp-action="EditProject" asp-route-id="@project.Id" asp-route-candidateId="@routeId" title="@Html.T("Common.Edit")">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" asp-action="DeleteProject" onsubmit="return confirm('@Html.T("Profile.DeleteProjectConfirm")');">
                                <input type="hidden" name="id" value="@project.Id" />
                                <input type="hidden" name="candidateId" value="@routeId" />
                                <button type="submit" class="icon-btn icon-btn-sm" title="@Html.T("Common.Delete")">
                                    <i class="bi bi-trash text-danger"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="project-period">
                        @project.StartDate.ToString("MMM yyyy") &ndash; @(project.EndDate?.ToString("MMM yyyy") ?? Html.T("Profile.Present"))
                    </div>
                    @if (!string.IsNullOrWhiteSpace(project.DescriptionMarkdown))
                    {
                        <div class="project-desc">@Html.Raw(CVPlatform.Web.Services.MarkdownRenderer.ToHtml(project.DescriptionMarkdown))</div>
                    }
                    @if (project.Tags.Any())
                    {
                        <div class="tag-row">
                            @foreach (var tag in project.Tags)
                            {
                                <span class="tag">@tag</span>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>