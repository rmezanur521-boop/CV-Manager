@model CVPlatform.Web.Models.Profile.ProjectFormViewModel
@{
    ViewData["Title"] = "New Project";
    var targetId = ViewBag.TargetId as string;
    var routeId = targetId != User.GetUserId() ? targetId : null;
}

<div class="page-header">
    <div>
        <h1>@Html.T("Profile.NewProject")</h1>
        @if (routeId != null)
        {
            <div class="text-muted small mt-1">
                <i class="bi bi-person-fill me-1"></i> Creating project for candidate
            </div>
        }
    </div>
    <div class="header-actions">
        <a class="btn btn-outline-secondary" asp-action="Projects" asp-route-id="@routeId" asp-route-candidateId="@routeId">@Html.T("Common.Cancel")</a>
        <button type="submit" form="project-form" class="btn btn-primary">@Html.T("Common.Save")</button>
    </div>
</div>

<div class="surface-card">
    <form asp-action="CreateProject" asp-route-candidateId="@routeId" asp-route-id="@routeId" method="post" id="project-form">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <input type="hidden" name="candidateId" value="@targetId" />

        <div class="field-grid mb-3">
            <div class="field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="StartDate"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="EndDate"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
        </div>

        <div class="field mb-3">
            <label asp-for="DescriptionMarkdown">@Html.T("Profile.Description")</label>
            <textarea asp-for="DescriptionMarkdown" class="form-control" rows="6"></textarea>
            <span asp-validation-for="DescriptionMarkdown" class="text-danger"></span>
        </div>

        <div class="field mb-1 position-relative">
            <label asp-for="TagsCsv">@Html.T("Profile.TechnologyTags")</label>
            <input asp-for="TagsCsv" id="TagsCsv" class="form-control" autocomplete="off" />
            <span asp-validation-for="TagsCsv" class="text-danger"></span>
            <div id="tag-suggestions" class="list-group position-absolute"></div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">@Html.T("Common.Save")</button>
            <a class="btn btn-outline-secondary ms-2" asp-action="Projects" asp-route-id="@routeId" asp-route-candidateId="@routeId">@Html.T("Common.Cancel")</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/tag-autocomplete.js"></script>
}
