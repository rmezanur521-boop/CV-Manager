@model CVPlatform.Web.Models.Profile.MeViewModel
@{
    ViewData["Title"] = "My Profile";
    var summary = (CVPlatform.Web.Models.Profile.ProfileSummaryViewModel)ViewBag.Summary;
    var targetId = ViewBag.TargetId as string;
    var hasPhoto = !string.IsNullOrWhiteSpace(Model.PhotoUrl);
}

<div class="page-header justify-content-between">
    <h1>@Html.T("Profile.Me")</h1>
    <div class="header-actions">
        <a class="btn btn-outline-primary" asp-action="CrmSync" asp-route-id="@ViewBag.TargetId">
            <i class="bi bi-cloud-arrow-up"></i> @Html.T("Crm.SyncToCrm")
        </a>
    </div>
</div>

<div class="profile-grid">
    @await Html.PartialAsync("_ProfileSummaryCard", summary)

    <div class="profile-content-card">
        @await Html.PartialAsync("_ProfileTabs", "Me")

        <!-- Avatar Upload / Manage Section -->
        <div class="avatar-management-card p-3 mb-4 rounded border bg-body-tertiary">
            <h5 class="mb-3"><i class="bi bi-person-bounding-box me-2"></i>Profile Picture</h5>
            <div class="d-flex align-items-center gap-4 flex-wrap">
                <div class="avatar-preview-box position-relative" style="width: 100px; height: 100px; border-radius: 50%; overflow: hidden; background: #e2e8f0; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold; color: #475569; border: 3px solid #cbd5e1;">
                    <img id="avatar-preview-img" src="@(hasPhoto ? Model.PhotoUrl : "")" alt="Avatar" style="width:100%; height:100%; object-fit:cover; display:@(hasPhoto ? "block" : "none");" />
                    <span id="avatar-preview-initials" style="display:@(hasPhoto ? "none" : "inline");">@summary.Initials</span>
                </div>
                <div class="avatar-actions d-flex flex-column gap-2">
                    <form id="avatar-form" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="candidateId" value="@targetId" />
                        <input type="file" id="avatar-file-input" name="file" accept="image/jpeg,image/png,image/webp" style="display:none;" />
                        
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <button type="button" id="btn-select-photo" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-upload me-1"></i>@(hasPhoto ? "Change Photo" : "Upload Photo")
                            </button>
                            <button type="button" id="btn-save-photo" class="btn btn-success btn-sm" style="display:none;">
                                <i class="bi bi-check-lg me-1"></i>Save Photo
                            </button>
                            <button type="button" id="btn-cancel-photo" class="btn btn-outline-secondary btn-sm" style="display:none;">
                                <i class="bi bi-x-lg me-1"></i>Cancel
                            </button>
                            <button type="button" id="btn-delete-photo" class="btn btn-outline-danger btn-sm" style="display:@(hasPhoto ? "inline-block" : "none");">
                                <i class="bi bi-trash me-1"></i>Delete
                            </button>
                        </div>
                    </form>
                    <small class="text-muted">JPG, PNG, or WebP. Max 5 MB.</small>
                    <div id="avatar-status-msg" class="small mt-1"></div>
                </div>
            </div>
        </div>

        <div id="me-form"
             data-concurrency-stamp="@Model.ConcurrencyStamp"
             data-saved-text="@Html.T("Profile.SavedJustNow")"
             data-saving-text="@Html.T("Profile.SavingStatus")">
            <div class="field-grid">
                <div class="field">
                    <label>@Html.T("Profile.FirstName")</label>
                    <input id="FirstName" class="form-control" value="@Model.FirstName" />
                </div>
                <div class="field">
                    <label>@Html.T("Profile.LastName")</label>
                    <input id="LastName" class="form-control" value="@Model.LastName" />
                </div>
                <div class="field">
                    <label>@Html.T("Profile.Location")</label>
                    <input id="Location" class="form-control" value="@Model.Location" />
                </div>
                <div class="field">
                    <label>@Html.T("Profile.PhotoUrl")</label>
                    <input id="PhotoUrl" class="form-control" value="@Model.PhotoUrl" placeholder="https://... or uploaded locally" />
                </div>
            </div>
            <div class="autosave-status mt-3">
                <i class="bi bi-cloud-check"></i>
                <span id="save-status"></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile-autosave.js"></script>
    <script src="~/js/profile-avatar.js" asp-append-version="true"></script>
}
